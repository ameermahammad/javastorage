class Harshadnum 
{
	public static void main(String[] args) 
	{
		int num=111;
		int temp=num;
		int sum=0;
		int ld=0;
		while (num!=0)
		{
			ld=num%10;
			sum=sum+ld;
			num=num/10;
		}
		num=temp;
		if (temp%sum==0)
		{
			System.out.println("Harshadnum ");
		}
		else
		{
          System.out.println(" not Harshadnum ");
		} 
	}
}
