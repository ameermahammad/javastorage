class Practice 
{
	public static void main(String[] args) 
	{
		for (int a=1;a<=3 ;a++ )
		{
			for (int b=3;b>=1 ;b-- )
			{
				if (a<=b)
				{

					for (int i=1;i<=3 ;i++ )
					{
						System.out.print(" * ");
					}
					System.out.println();
					for (int j=0;j<=2 ;j++ )
					{
						if (j%2==0)
						{
							System.out.print(" "+j+" ");
						}
					}
					System.out.println();
					for (char k='a';k<='a' ;k++ )
					{
						System.out.print(" "+k+" ");
					}
					System.out.println();
				}
			}
			System.out.println();
		}
	}
}
