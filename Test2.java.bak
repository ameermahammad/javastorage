import java.util.Scanner;
class Test2 
{
	public static void main(String[] args) 
	{
		
		for (int x=1;x<=1000;x++ )
		{
		
		int temp=x;
		int count=0;
		while (x!=0)
		{
			count++;
			x=x/10;
		}
		x=temp;
		int sum=0;
		int ld=0;
		while (x!=0)
		{
			ld=x%10;
			int exp=1;
			for (int a=1;a<=count;a++ )
			{
				exp=exp*ld;
			}
			sum=sum+exp;
			x=x/10;
		}
		
		x=temp;
		if (sum==temp)
		{
			System.out.println(sum);
		}
		}
	}
}
