class Naturalnum1to100 
{
	public static void main(String[] args) 
	{
		int count=0;
		for (int i=1;i<=100 ;i++ )
		{
		  for (int a=1;a<=i ;a++ )
		  {
			if (i%a==0)
			{
				count++;
			}
		  }
		if (count==2)
		{
         System.out.println(i+" )prime number");
		}
		else if (count>2)
		{
         System.out.println(i+" )composite number");
		}
		else
	    {
		System.out.println(i+" )neithser prime or not number");
		
		}
		

	}
}

}
