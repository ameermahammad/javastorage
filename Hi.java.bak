import java.util.Scanner
class Hi
{
	public static void main(String[] args) 
	{
        Scanner scan = new Scanner(System.in);
		double pie=3.14;
		System.out.println("Enter hight value:");
		int h= scan.nextInt();
		System.out.println("Enter radious value:");
