import java.util.Scanner;
class While_do 
{
	public static void main(String[] args) 
	{
		Scanner scan= new Scanner(System.in);
		System.out.println("enter minimum range");
		int a=scan.nextInt();
		System.out.println("enter maximum range");
		int b=scan.nextInt();
		int c=a;
		while (c<=b)
		{
			System.out.println(c);
			c++;
		}
	}
}
