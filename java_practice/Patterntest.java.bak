class Patterntest 
{
	public static void main(String[] args) 
	{
		int space=0;
		int star=3;
		for (int a=1;a<=3 ;a++ )
		{
			for (int b=1;b<=space ;b++ )
			{
                System.out.print("  ");
			}
			for (int c=1;c<=star ;c++ )
			{
                System.out.print(" * ");
			}
			System.out.println();
			space++;
		}
	}
}
