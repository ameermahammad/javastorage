class Keithnum 
{
	public static void main(String[] args) 
	{
		int n=19;
		int temp=n;
		int c=n%10;
		n=n/10;
		int b=n%10;
		n=n/10;
		int a=n%10;
		n=n/10;
		int sum=0;
		for (int i=1;sum<temp ;i++ )
		{
			sum=a+b+c;
			a=b;
			b=c;
		    c=sum;
		}
		if (sum==temp)
		{
			System.out.println("keith num");
		}
		else
		{
          System.out.println(" not keith num");
		}
	}
}
