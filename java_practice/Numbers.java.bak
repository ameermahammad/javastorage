class Numbers 
{
	public static void main(String[] args) 
	{
		int star=5;
		int space=0;
		
		for (int i=1;i<=5 ;i++ )
		{
			
			for (int j=1;j<=star ;j++ )
			{
				if (i==1||i==5)
				{
                    System.out.print(" 3 ");
				}
				else if (i==2||i==4)
				{
					System.out.print(" 2 ");
				}
				else
				{
					System.out.print(" 1 ");
				}
			}
            for (int j=1;j<=space ;j++ )
			{
				System.out.print("   ");
			}
			if(i<=2)
			{
			star=star-2;
			space++;
			}
			else
			{
				star=star+2;
				space--;
			}
			System.out.print("\n");
			System.out.println();
		}
	}
}
