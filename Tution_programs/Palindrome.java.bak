import java.util.*;
class Palindrome 
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("enter a string");
		String s=sc.next();
		int l=s.length();
		String rev="";
		for(int i=l-1;i>=0;i--)
		{
			rev=rev+s.charAt(i);
			
			
		}
		if (s.equals(rev))
		{
			System.out.println("is a palindrome word");
		}
		else
		{
			System.out.println("is not a palindrome word");
		}
	}
}
