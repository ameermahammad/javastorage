class Mock3 
{
	public static void main(String[] args) 
	{
		int star=1;
		int space=4;
		
		for (int a=1;a<=5;a++ )
		{
			
		     for (int c=1;c<=space ;c++ )
			{
			 System.out.print("   ");
			}
			for (int d=1;d<=star ;d++ )
			{
				System.out.print(" * ");
				
			}
			if (a<=4||a==c)
			{
				space--;
				star=star+2;
				
			}
			
			System.out.println();
		}
	}
}
