class Triangle 
{
	public static void main(String[] args) 
	{
		
		
		
		int star=1;
		int space=4;
        
		for (int i=1;i<=5 ;i++ )
		{
			for (int j=1;j<=space-i;j++ )
			{
				System.out.print(" ");
			}
				for (int k=i;k>=1 ;k-- )
				{
					System.out.print(" "+k+" ");
				}
				for (int l=2;l<=i ;l++ )
				{
					System.out.print(""+l+" ");
				}
				System.out.println("\n");
				System.out.println();
				star=star+2;
			    space--;
			
		}
	}
}
