class Q1 
{
	public static void main(String[] args) 
	{
		int a=100;
		for (int i=1;i<=4 ;i++ )
		{
			for (int j=1;j<=4 ;j++ )
			{
				if (i>=j)
				{
					System.out.print(" "+a+" ");
					while (true)
					{
						a++;
						int count=0;
						for (int b=1;b<=a ;b++ )
						{
							if (a%b==0)
							{
								count++;
							}
						}
						if (count==2)
						{
							break;
						}
					}
				}
				else
				{
					System.out.print("   ");
				}
			}
			for (int j=4;j>=1 ;j-- )
			{
				if (i>=j)
				{
					System.out.print(" "+a+" ");
					while (true)
					{
						a++;
						int count=0;
						for (int b=1;b<=a ;b++ )
						{
							if (a%b==0)
							{
								count++;
							}
						}
						if (count==2)
						{
							break;
						}
					}
					
				}
				else
				{
					System.out.print("   ");
				}
			}
            System.out.println("\n");
			System.out.println();
		}
	}
}
