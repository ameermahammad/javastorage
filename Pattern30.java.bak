class Pattern30
{
	public static void main(String[] args) 
	{
		
		int star=1;
		int space=4;
		for (int i=1;i<=9;i++)
		{
			for (int j=1;j<=star;j++)
			{
				System.out.print(" * ");
			}
			if (i<=4)
			{
				star++;
				
			}
			else if(i<=4)
			{
				star--;
				
			}
			else if(i<=4)
			{
				space--;
			}
			else 
			{
				space++;
			}
			System.out.println();
			
			
		}
		
	}
}
 
