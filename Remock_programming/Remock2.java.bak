import java.util.Scanner;
class Remock2 
{
	public static void main(String[] args) 
	{
		Scanner scan=new Scanner(System.in);
		System.out.println("enter a m value");
        int m=scan.nextInt();
		System.out.println("enter a n value");
        int n=scan.nextInt();
		
		for (int i=m;i<=n ;i++ )
		{
			int count=0;
			for (int j=1;j<=i ;j++ )
			{
			
			if (i%j==0)
			{
				count++;
			}
			}
		
		if (count==2)
		{
			int count1=0;
			int ld=0; 
			int temp=i;
			while (i!=0)
			{
				 ld=i%10;
				count1++;
				i=i/10;
			}
			i=temp;
			if (count1==1)
			{
				System.out.println(ld);
				
			}
		}
		}
	}
}
