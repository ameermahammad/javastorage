class Pattern10
{
	public static void main(String[] args) 
	{
		for (int a=1;a<=7 ;a++)
		{
			for (int b=1;b<=7 ; b++)
			{
				if (a==1 || a==7 || b==1 || b==7 || a==4 && b==4)
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print(" ");
				}
			}
			System.out.println();
			
		}
		
	}
}
