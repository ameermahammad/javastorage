class Patternpq2 
{
	public static void main(String[] args) 
	{
		int j=1;
		int i=6;
		int ch=10;
		int l=13;
		int m=15;
		for (int a=1;a<=5 ;a++ )
		{
			for (int b=5; b>=1;b-- )
			{
				if (a<=b)
				{
					if (b==1)
					{
						System.out.print(" "+m+" ");
						
					}
					else if (b==2)
					{
						System.out.print(" "+l+" ");
						l++;
					}
					else if (b==3)
					{
						System.out.print(" "+ch+" ");
						ch++;
					}
					else if(b==4)
					{
						System.out.print(" "+i+" ");
						i++;
					}
					else if(b==5)
					{
						System.out.print(" "+j+" ");
						j++;
					}
					else
					{
						System.out.print("   ");
					}
				}
			}
			System.out.println();
		}
	}
}
