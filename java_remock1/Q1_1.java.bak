class Q1_1 
{
	public static void main(String[] args) 
	{
		int x=2;
		for (int a=1;a<=5 ;a++ )
		{
			for (int b=1;b<=5 ;b++ )
			{
				if (a>=b)
				{
					if (x<=9)
					{
						System.out.print(x+"   ");
					}
					else if (x<=99)
					{
						System.out.print(x+"  ");
					}
					else
					{
						System.out.print(x+" ");
					}
			   while (true)
			   {
				   x++;
				   int count=0;
				   for (int z=1;z<=x ;z++ )
				   {
					   if (x%z==0)
					   {
						   count++;
					   }
				   }
				   if (count==2)
				   {
					   
					   break;
				   }
			   }
				}
				else
				{
                   System.out.print("    ");   
				}
			}
			for (int b=5;b>=1 ;b-- )
			{
				if (a>=b)
				{
					if (x<=9)
					{
						System.out.print(x+"   ");
					}
					else if (x<=99)
					{
						System.out.print(x+"  ");
					}
					else
					{
						System.out.print(x+" ");
					}
			   while (true)
			   {
				   x++;
				   int count=0;
				   for (int z=1;z<=x ;z++ )
				   {
					   if (x%z==0)
					   {
						   count++;
					   }
				   }
				   if (count==2)
				   {
					   
					   break;
				   }
			   }
				}
				else
				{
                   System.out.print("    ");
				}
			}
			System.out.println();
		}
	}
}
