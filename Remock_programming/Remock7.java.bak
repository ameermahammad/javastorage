class Remock7 
{
	public static void main(String[] args) 
	{
		
		for (int a=1;a<=5;a++)
		{
			for (int b=0;b<5 ;b++ )
			{
				if (a+b==6)
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print("   ");
				}
			}

			for (int c=1;c<=5 ;c++ )
			{
				if (a==c )
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print("   ");
				}
			}
			System.out.println();
			
			
		}
		for (int i=1;i<=5;i++)
		{
			for (int j=1;j<5 ;j++ )
			{
				if (i==j)
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print("   ");
				}
			}

			for (int k=1;k<=5 ;k++ )
			{
				if (i+k==6)
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print("   ");
				}
			}
			System.out.println();
			
			
		}
	}
}
