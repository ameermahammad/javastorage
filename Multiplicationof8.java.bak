import java.util.Scanner;
class Multiplicationof8
{
	public static void main(String[] args) 
	{
		Scanner scan=new Scanner(System.in);
        System.out.println("enter multiplication number");
		int a=scan.nextInt();
		System.out.println("enter multiplication number");
		int c=scan.nextInt();
		for (int b=a; b<=c;b++ )
		{
			if (b%8==0)
			{
				System.out.println(b);
			}
		}
	}
}
