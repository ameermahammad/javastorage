import java.util.Scanner;
class Automorphic 
{
	public static void main(String[] args) 
	{
		Scanner scan= new Scanner(System.in);
		System.out.println("enter a number");
		int num =scan.nextInt();
		int temp=num;
		int ld=0;
		int sq=num*num;
		while (num>0)
		{
				ld=sq%10;
				num=num/10;
		}
			num=temp;
			if (num==sq)
			{
              System.out.println("automorphic");
			}
			else
			{
				System.out.println("not");
			}
		
	}
}
