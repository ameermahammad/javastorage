class Primenum1to100 
{
	public static void main(String[] args) 
	{
		for (int i=1;i<=100 ; i++)
		{
			int count=0;
			for (int a=1;a<=i; a++)
			{
				if (i%a==0)
				{
					count++;
				}
			}
			if (count==2)
			{
				int count1=0;
				int ld=0;
				while (i!=0)
				{
					count1++;
					i=i/10;
				}
				if (count1==1)
				{
					System.out.println(i);
					break;
				}
			}
		}
		
	}
}
