class Pattern35
{
	public static void main(String[] args) 
	{
		int x=11;
		int count=0;
		for (int i=1;i<=5;i++)
		{
			for (int j=5;j>=1;j--)
			{
				if (j>=i)
				{
					count++;
				}
					if (count==2)
					{
						System.out.print(" "+x+" ");
					}
					
					x++;
				
				else
				{
					System.out.print("   ");
				}
			}
			System.out.println();
			
		}
		
	}
}
 
