class Prime 
{
	public static void main(String[] args) 
	{
		int n=149;
		int temp=n;
		int count1=0;
		int count2=0;
		int ld=0;
		while (n!=0)
		{
             ld=n%10;
             if (n%2==0)
             {
				 count1++;
             }
			 else
			{
				 count2++;
			}
			n/=10;
		}
		n=temp;
		if (count2>count1)
		{
           int count3=0;
		   for (int i=2;i<=n/2;i++)
		   {
			   if (n%i==0)
			   {
				   count3++;
			   }
		   }
		   if (count3==2)
		   {
			   System.out.println("prime number");
		   }
		   else
			{
				System.out.println("not a prime");
			}
		}
	}
}
