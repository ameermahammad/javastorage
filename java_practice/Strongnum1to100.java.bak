import java.util.Scanner;
class Strongnum1to100 
{
	public static void main(String[] args) 
	{
		Scanner scan=new Scanner(System.in);
		System.out.println("enter a number");
		int num= scan.nextInt();
		for (int i=1;i<=num;i++ )
		{
			int sum=0;
		   int ld=0;
		    int temp=num; 
			while (i!=0)
			{
			ld=i%10;
			int fact=1;
			for (int a=1;a<=ld ;a++ )
			{
				fact=fact*a;
			}
			sum=sum+fact;
			i=i/10;
			}
		
		num=temp;
		if (sum==temp)
		{
			System.out.println(sum);
		}
		
		}
	}
}
