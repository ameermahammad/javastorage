class Patternanother1 
{
	public static void main(String[] args) 
	{
		int star=9;
		int space=0;
		for (int i=1; i<=9; i++)
		{
			for (int a=1;a<=star ;a++ )
			{
				System.out.print("   ");
			}
			for (int b=1;b<=space ;b++ )
			{
				System.out.print(" * ");
			}
			if (i<=4)
			{
				star=star-2;
				space++;
			}
			else
			{
				star=star+2;
				space--;
			}
			System.out.println();
		}
		
	}
}
