class NonFibonacci1to100 
{
	public static void main(String[] args) 
	{
		for (int n=1;n<=100 ;n++ )
		{
		  int a=0;
		  int b=1;
		  int sum=0;
		  for (int i=1;i<=n ;i++ )
		  {
			  
			  a=b;
			  b=sum;
			  sum=a+b;
			  if (sum!=n)
			  {
                 System.out.println(sum);
			  }
		  }
		}
	}
}
