class prime 
{
	public static void main(String[] args) 
	{
		int n=345824;
		int temp=n;
		int count1=0;
		int count2=0;
		while (n!=0)
		{
             if (n%2==0)
             {
				 count1++;
             }
			 else
			{
				 count2++;
			}
		}
		if (count2>count1)
		{
           int count3=0;
		   for (int i=2;i<=temp;i++)
		   {
			   if (temp%i==0)
			   {
				   count3++;
			   }
		   }
		   if (count3==2)
		   {
			   System.out.println("prime number");
		   }
		}
	}
}
