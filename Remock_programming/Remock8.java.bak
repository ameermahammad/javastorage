class Remock8 
{
	public static void main(String[] args) 
	{
		for (int a=1;a<=5 ;a++ )
		{
			for (int b=1;b<5 ;b++ )
			{
				if (b==1||a==b)
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print("   ");
				}
			}
			for (int c=1;c<=5 ;c++ )
			{
				if (c==5||a+c==6)
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print("   ");
				}
			}
			System.out.println();
		}
		for (int a=1;a<=5 ;a++ )
		{
			for (int b=1;b<5 ;b++ )
			{
				if (b==1||a+b==6)
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print("   ");
				}
			}
			for (int c=1;c<5 ;c++ )
			{
				if (c==5||a==c)
				{
					System.out.print(" * ");
				}
				else
				{
					System.out.print("   ");
				}
			}
			System.out.println();
		}
	}
}
